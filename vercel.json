{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "www.drasarina.com.br"
        }
      ],
      "destination": "https://drasarina.com.br/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.drasarina.com.br"
        }
      ],
      "destination": "https://drasarina.com.br/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/blog",
      "destination": "https://blog-sarina.vercel.app/blog"
    },
    {
      "source": "/blog/:path*",
      "destination": "https://blog-sarina.vercel.app/blog/:path*"
    },
    {
      "source": "/_next/:path*",
      "destination": "https://blog-sarina.vercel.app/_next/:path*"
    },
    {
      "source": "/brand/:path*",
      "destination": "https://blog-sarina.vercel.app/brand/:path*"
    }
  ]
}
